      "invented product or gameplay proof"
    ],
    "best_for": [
      "anime promotional video",
      "product or character identity reveal"
    ],
    "direction": {
      "composition": "balance a character portrait with a restrained identity title; keep one dominant focal hierarchy and legible supporting evidence.",
      "typography": "Use celestial motif,delicate rim,hero portrait,quiet resolve,orbital detail,lyrical reveal as hierarchy cues; keep display copy short and body copy readable at final delivery size.",
      "lighting": "moonlit cyan rim; preserve subject contour and separate it from the supporting field.",
      "materials": "silver ornament and dark satin; actual material appearance comes from approved imagery or a real 3D asset.",
      "camera": "Guide attention with celestial motif; use a deliberate hold, a measured approach and a stable payoff.",
      "editing": "Open with delicate rim; alternate proof and breathing room, then resolve with lyrical reveal.",
      "sound": "Create a restrained rhythm around orbital detail; place licensed accents on intentional cuts and keep speech clear."
    },
    "beat_plan": [
      "Hook: celestial motif",
      "Establish: balance a character portrait with a restrained identity title",
      "Prove: use an approved local capture or truthful designed-motion detail",
      "Payoff: lyrical reveal with one clear final identity"
    ],
