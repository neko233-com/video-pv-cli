  "style": {
    "schema_version": "1.0",
    "id": "anime-celestial-heroine",
    "name": "星辉角色",
    "family": "anime",
    "summary": "星辉角色：balance a character portrait with a restrained identity title. Original direction recipe; real footage and bespoke assets determine final visual fidelity.",
