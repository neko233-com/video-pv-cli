  "style": {
    "schema_version": "1.0",
    "id": "keynote-silent-reveal",
    "name": "静场揭幕",
    "family": "keynote",
    "summary": "静场揭幕：one hero isolated inside a wide empty field. Original direction recipe; real footage and bespoke assets determine final visual fidelity.",
    "keywords": [
      "negative space",
      "restrained reveal",
      "hero silhouette",
      "single promise",
      "quiet stage",
      "slow release"
    ],
    "avoid": [
      "unmotivated decorative motion",
      "unreadable small copy",
      "invented product or gameplay proof"
    ],
    "best_for": [
      "keynote promotional video",
      "product or character identity reveal"
    ],
    "direction": {
      "composition": "one hero isolated inside a wide empty field; keep one dominant focal hierarchy and legible supporting evidence.",
      "typography": "Use negative space,restrained reveal,hero silhouette,single promise,quiet stage,slow release as hierarchy cues; keep display copy short and body copy readable at final delivery size.",
      "lighting": "soft overhead pool; preserve subject contour and separate it from the supporting field.",
      "materials": "matte aluminum and diffused glass; actual material appearance comes from approved imagery or a real 3D asset.",
      "camera": "Guide attention with negative space; use a deliberate hold, a measured approach and a stable payoff.",
      "editing": "Open with restrained reveal; alternate proof and breathing room, then resolve with slow release.",
      "sound": "Create a restrained rhythm around quiet stage; place licensed accents on intentional cuts and keep speech clear."
    },
    "beat_plan": [
      "Hook: negative space",
      "Establish: one hero isolated inside a wide empty field",
      "Prove: use an approved local capture or truthful designed-motion detail",
      "Payoff: slow release with one clear final identity"
    ],
    "reference_ids": [
      "hyperframes-creative",
      "hyperframes-product-launch",
      "video-shotcraft",
      "product-demo-video"
    ],
